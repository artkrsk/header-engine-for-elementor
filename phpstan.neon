includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
	level: max
	phpVersion: 80000
	paths:
		- src/php
	bootstrapFiles:
		- vendor/autoload.php
		- phpstan-bootstrap.php
	scanFiles:
		- vendor/arts/elementor-stubs/elementor-stubs.php
	# Elementor's Plugin::$instance and its manager properties are typed only via
	# @var docblocks with a null default. At the default (true), PHPStan would
	# treat "! Plugin::$instance" guards as always-false dead code — wrong before
	# Elementor boots.
	treatPhpDocTypesAsCertain: false
