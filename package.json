{
  "name": "@arts/header",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev": "vite",
    "dev:plugin": "arts-wp dev",
    "build": "arts-wp build",
    "release": "arts-wp release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:library": "node scripts/build-library.mjs"
  },
  "devDependencies": {
    "@arts/wp-plugin-tooling": "github:artkrsk/wp-plugin-tooling",
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "fallow": "3.8.0",
    "happy-dom": "20.11.1",
    "knip": "6.29.0",
    "lefthook": "^2.1.10",
    "lenis": "^1.3.17",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "5.0.1",
    "sass": "^1.101.0"
  },
  "dependencies": {
    "@artemsemkin/elementor-types": "^2.0.0"
  },
  "exports": {
    ".": {
      "arts-source": "./src/ts/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./contract": {
      "arts-source": "./src/ts/contract/index.ts",
      "types": "./dist/types/contract/index.d.ts",
      "import": "./dist/esm/contract.js",
      "default": "./dist/esm/contract.js"
    },
    "./package.json": "./package.json",
    "./src/ts/*": "./src/ts/*",
    "./src/styles/*": "./src/styles/*",
    "./styles.scss": "./src/styles/index.scss",
    "./styles.css": "./dist/esm/styles.css"
  },
  "files": [
    "dist/esm",
    "dist/types",
    "src/ts",
    "src/styles",
    "composer.json"
  ]
}
