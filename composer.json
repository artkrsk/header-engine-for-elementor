{
  "name": "arts/header-engine-for-elementor",
  "description": "Sticky and auto-hide header for Elementor containers. Hide on scroll down, reveal on scroll up, logo swap, sticky styling. Free, zero dependencies.",
  "version": "1.0.0",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "wordpress": {
    "Requires at least": "6.5",
    "Tested up to": "7.1",
    "Requires PHP": "8.0"
  },
  "plugin": {
    "Plugin Name": "Artem Semkin Header Engine for Elementor",
    "Plugin URI": "https://artemsemkin.com/plugins/header-engine-for-elementor/",
    "Description": "Sticky and auto-hide header for Elementor containers. Hide on scroll down, reveal on scroll up, logo swap, sticky styling. Free, zero dependencies.",
    "Author": "Artem Semkin",
    "Author URI": "https://artemsemkin.com",
    "Text Domain": "artem-semkin-header-engine-for-elementor",
    "License": "GPLv3",
    "License URI": "https://www.gnu.org/licenses/gpl-3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Arts\\HeaderForElementor\\": "src/php/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "arts/elementor-stubs": "^4.0",
    "arts/wp-plugin-standards": "^1.0"
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=1G",
    "pre-autoload-dump": [
      "@php -r \"is_dir('vendor-prefixed') || mkdir('vendor-prefixed');\""
    ]
  }
}
