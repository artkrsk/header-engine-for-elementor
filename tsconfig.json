{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@engine": ["./src/ts/index.ts"],
      "@styles/*": ["./src/styles/*"],
      "@ts/*": ["./src/ts/*"]
    }
  },
  "include": ["src/ts/**/*", "playground/**/*", "tests/**/*", "vite.config.ts", "vitest.config.ts"]
}
