# Machine-specific dev sync target for `pnpm dev:plugin`: the plugin directory
# of a Local site. The last path segment must be the plugin slug — TGM matches
# an installed plugin by folder name, and an off-name folder reads as "not
# installed", so it offers a duplicate from wp.org instead. E.g.
# DEV_TARGET=/Users/art/Local Sites/fluid-ds/app/public/wp-content/plugins/artem-semkin-header-engine-for-elementor
